# ---------------------------------------------------------------------------
# Patient data must never enter this repository.
# ---------------------------------------------------------------------------
# The analysis code reads individual-level clinical and dosimetric data that
# cannot be redistributed. Everything the pipelines read or write as data is
# ignored here by default.
data/
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather

# Medical imaging and dose files.
*.dcm
*.DCM
*.nii
*.nii.gz
*.mha
*.mhd
*.nrrd

# ---------------------------------------------------------------------------
# Pipeline outputs (regenerated by running the code).
# ---------------------------------------------------------------------------
prep/
models/
results/
figures*/
contrasts*/
headroom*/
mcid*/
catboost_info/
*.joblib
*.cbm
*.pt
*.pkl
*.png
*.pdf
*.tex
*.json
!requirements.json

# ---------------------------------------------------------------------------
# Environment and tooling.
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.DS_Store
.idea/
.vscode/
*.log
